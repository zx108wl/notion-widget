{
  "schemaVersion": 1,
  "id": "status",
  "icon": {
    "type": "image",
    "src": "./icon.svg",
    "alt": "服务状态",
    "fallback": "◷"
  },
  "name": "服务状态",
  "summary": "检测后端 API 状态",
  "description": "展示当前服务连通情况，并按设定频率自动刷新。",
  "version": "0.1.0",
  "entry": {
    "js": "./index.ts",
    "css": [
      "./style.css"
    ]
  },
  "defaultSize": {
    "width": 360,
    "height": 160
  },
  "fields": [
    {
      "key": "title",
      "label": "标题",
      "type": "text",
      "default": "服务状态"
    },
    {
      "key": "refresh",
      "label": "刷新间隔（秒）",
      "type": "number",
      "default": "30",
      "min": 5,
      "max": 300,
      "step": 5,
      "control": {
        "type": "slider",
        "showInput": true,
        "unit": "秒"
      }
    },
    {
      "key": "width",
      "label": "组件宽度（px，留空自适应）",
      "type": "number",
      "default": "",
      "min": 280,
      "max": 1200,
      "step": 1
    },
    {
      "key": "height",
      "label": "组件高度（px，留空自适应）",
      "type": "number",
      "default": "",
      "min": 160,
      "max": 1000,
      "step": 1
    },
    {
      "key": "theme",
      "label": "组件主题",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "跟随系统"
        },
        {
          "value": "light",
          "label": "浅色"
        },
        {
          "value": "dark",
          "label": "深色"
        }
      ]
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "default": "#6c5ce7"
    }
  ]
}
