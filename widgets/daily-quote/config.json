{
  "schemaVersion": 1,
  "id": "daily-quote",
  "icon": {
    "type": "image",
    "src": "./icon.svg",
    "alt": "每日一句",
    "fallback": "❝"
  },
  "name": "每日一句",
  "summary": "一言句子 + 随机壁纸背景",
  "description": "句子来自一言 API，背景来自随机壁纸 API；背景按 cover 裁剪、不拉伸、居中显示。",
  "version": "0.2.0",
  "entry": {
    "js": "./index.ts",
    "css": [
      "./style.css"
    ]
  },
  "defaultSize": {
    "width": 480,
    "height": 260
  },
  "fields": [
    {
      "key": "title",
      "label": "标题",
      "type": "text",
      "default": "每日一句"
    },
    {
      "key": "category",
      "label": "句子分类",
      "type": "select",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "随机"
        },
        {
          "value": "d",
          "label": "文学"
        },
        {
          "value": "i",
          "label": "诗词"
        },
        {
          "value": "k",
          "label": "哲学"
        },
        {
          "value": "h",
          "label": "影视"
        },
        {
          "value": "a",
          "label": "动画"
        },
        {
          "value": "f",
          "label": "来自网络"
        },
        {
          "value": "l",
          "label": "抖机灵"
        }
      ]
    },
    {
      "key": "backgroundCategory",
      "label": "背景分类",
      "type": "select",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "随机"
        },
        {
          "value": "nature",
          "label": "风景"
        },
        {
          "value": "anime",
          "label": "动漫"
        },
        {
          "value": "game",
          "label": "游戏"
        },
        {
          "value": "animal",
          "label": "动物"
        },
        {
          "value": "city",
          "label": "城市"
        },
        {
          "value": "abstract",
          "label": "抽象"
        },
        {
          "value": "space",
          "label": "宇宙"
        },
        {
          "value": "car",
          "label": "汽车"
        },
        {
          "value": "sport",
          "label": "运动"
        }
      ]
    },
    {
      "key": "width",
      "label": "组件宽度（px，留空自适应）",
      "type": "number",
      "default": "",
      "min": 280,
      "max": 1200,
      "step": 1
    },
    {
      "key": "height",
      "label": "组件高度（px，留空自适应）",
      "type": "number",
      "default": "",
      "min": 160,
      "max": 1000,
      "step": 1
    }
  ]
}
