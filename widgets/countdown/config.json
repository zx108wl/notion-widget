{
  "schemaVersion": 1,
  "id": "countdown",
  "icon": "⌛",
  "name": "倒计时",
  "summary": "为重要日期倒数",
  "description": "设置目标时间，实时展示剩余天、小时、分钟和秒。",
  "version": "0.1.0",
  "entry": {
    "js": "./index.js",
    "css": [
      "./style.css"
    ]
  },
  "fields": [
    {
      "key": "title",
      "label": "事件名称",
      "type": "text",
      "default": "距离目标还有"
    },
    {
      "key": "target",
      "label": "目标时间",
      "type": "datetime-local",
      "default": "",
      "defaultValue": {
        "kind": "relative-date",
        "days": 7
      }
    },
    {
      "key": "completed",
      "label": "结束提示",
      "type": "text",
      "default": "目标时间已到"
    },
    {
      "key": "width",
      "label": "组件宽度（px，留空自适应）",
      "type": "number",
      "default": "",
      "min": 280,
      "max": 1200,
      "step": 1
    },
    {
      "key": "height",
      "label": "组件高度（px，留空自适应）",
      "type": "number",
      "default": "",
      "min": 160,
      "max": 1000,
      "step": 1
    },
    {
      "key": "theme",
      "label": "显示主题",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "跟随系统"
        },
        {
          "value": "light",
          "label": "浅色"
        },
        {
          "value": "dark",
          "label": "深色"
        }
      ]
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "default": "#6c5ce7"
    }
  ]
}
