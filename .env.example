PORT=3000
WEB_PORT=18080

# ===== 主密钥（对称密钥，不是证书）=====
# 可留空：首次启动会自动生成到独立密钥卷 /key/master.key（compose 挂载 widget-key）。
# 填写后优先使用环境变量，适合已有部署或希望由外部密钥管理系统注入。
# 32 字节随机数的 base64，`openssl rand -base64 32` 生成；绝不入库、绝不进镜像。
# 备份时必须与数据库文件分开存放，缺一都救不回来。
WIDGET_DB_KEY=

# 密钥文件路径（compose 里固定为独立卷内的 /key/master.key）
WIDGET_KEY_PATH=/key/master.key

# 数据库文件路径（compose 里固定指向持久化卷 /data）
WIDGET_DB_PATH=/data/widget.db

# ===== 首次引导管理员 =====
# 仅在 users 表为空时创建；之后只校验库内哈希，改这里不会覆盖已有账号。
# ADMIN_USERNAME 留空默认 admin。
# ADMIN_PASSWORD 留空会自动生成随机密码：写入容器日志与 /key/initial-admin-password，
# 并强制首次登录改密；改完密码后请删除该文件。
ADMIN_USERNAME=
ADMIN_PASSWORD=
