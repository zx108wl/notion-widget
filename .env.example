PORT=3000
WEB_PORT=18080

# ===== 主密钥（对称密钥，不是证书）=====
# 32 字节随机数的 base64，用 `openssl rand -base64 32` 生成；加密库内所有第三方密钥。
# 绝不入库、绝不进镜像；备份时必须与数据库文件分开存放，缺一都救不回来。
WIDGET_DB_KEY=

# 数据库文件路径（compose 里固定指向持久化卷 /data）
WIDGET_DB_PATH=/data/widget.db

# ===== 首次引导管理员 =====
# 仅在 users 表为空时创建；之后只校验库内哈希，改这里不会覆盖已有账号。
ADMIN_USERNAME=
ADMIN_PASSWORD=
